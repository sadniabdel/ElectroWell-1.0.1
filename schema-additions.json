[
  {
    "name": "Header & Top Bar",
    "settings": [
      {
        "type": "heading",
        "content": "Top Bar Promotion Banner"
      },
      {
        "type": "checkbox",
        "label": "Enable Top Bar Promotion",
        "id": "topbar_promotion_enabled",
        "force_reload": true
      },
      {
        "type": "text",
        "label": "Top Bar Promotion Image URL",
        "id": "topbar_promotion_image",
        "description": "Upload image to WebDAV /content/ folder, then enter: /content/your-image.png"
      },
      {
        "type": "text",
        "label": "Top Bar Promotion Link URL",
        "id": "topbar_promotion_link"
      },
      {
        "type": "heading",
        "content": "Header Top Message"
      },
      {
        "type": "checkbox",
        "label": "Enable Free Shipping Message",
        "id": "header_freeshipping_enabled",
        "force_reload": true
      },
      {
        "type": "text",
        "label": "Free Shipping Message",
        "id": "header_freeshipping_text",
        "default": "Free International Shipping. No Minimum Purchase Required*"
      },
      {
        "type": "text",
        "label": "Free Shipping Detail Link",
        "id": "header_freeshipping_link",
        "default": "/shipping"
      },
      {
        "type": "heading",
        "content": "Header Phone Number"
      },
      {
        "type": "checkbox",
        "label": "Show Phone Number in Header",
        "id": "header_phone_enabled",
        "force_reload": true
      },
      {
        "type": "text",
        "label": "Phone Number",
        "id": "header_phone_number",
        "default": "1-800-123-4567"
      },
      {
        "type": "text",
        "label": "Phone Label Text",
        "id": "header_phone_label",
        "default": "Customer Service"
      },
      {
        "type": "heading",
        "content": "Need Help Link"
      },
      {
        "type": "checkbox",
        "label": "Show 'Need Help?' Link",
        "id": "header_needhelp_enabled",
        "force_reload": true
      },
      {
        "type": "text",
        "label": "'Need Help?' Link URL",
        "id": "header_needhelp_link",
        "default": "/contact-us"
      },
      {
        "type": "text",
        "label": "'Need Help?' Link Text",
        "id": "header_needhelp_text",
        "default": "Need Help?"
      }
    ]
  },
